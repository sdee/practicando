# Copy to .env.local (git-ignored) — or let `npm run db:setup` write it for you.
# Both values are browser-safe: row-level security limits them to the signed-in user's rows.
# Local dev always uses the `practicando_dev` schema, whatever these say.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
